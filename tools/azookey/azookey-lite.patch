+/// Only `.spellOut` in Japanese is used: 123 -> 百二十三.
+public final class NumberFormatter {
+    public enum Style { case none, spellOut }
+    public var numberStyle: Style = .none
+    public var locale: Locale? = nil
+    public init() {}
+    public func string(from number: NSNumber) -> String? {
+        let n = number.intValue
+        guard numberStyle == .spellOut else { return String(n) }
+        if n == 0 { return "〇" }
+        let digits = ["", "一", "二", "三", "四", "五", "六", "七", "八", "九"]
+        func small(_ v: Int) -> String {
+            var out = ""
+            for (unit, name) in [(1000, "千"), (100, "百"), (10, "十")] {
+                let d = (v / unit) % 10
+                if d > 0 { out += (d == 1 ? "" : digits[d]) + name }
+            }
+            return out + digits[v % 10]
+        }
+        var v = abs(n), out = "", units = ["", "万", "億", "兆"], i = 0
+        while v > 0 && i < units.count {
+            let part = v % 10000
+            if part > 0 { out = small(part) + units[i] + out }
+            v /= 10000; i += 1
+        }
+        return (n < 0 ? "マイナス" : "") + out
+    }
+}
