+public final class NSLock: @unchecked Sendable {
+    private var mutex = pthread_mutex_t()
+    public init() { pthread_mutex_init(&mutex, nil) }
+    deinit { pthread_mutex_destroy(&mutex) }
+    public func lock() { pthread_mutex_lock(&mutex) }
+    public func unlock() { pthread_mutex_unlock(&mutex) }
+    public func withLock<R>(_ body: () throws -> R) rethrows -> R {
+        lock(); defer { unlock() }
+        return try body()
+    }
+}
+
+public final class NSString: Hashable, @unchecked Sendable {
+    public let value: String
+    public init(_ value: String) { self.value = value }
+    public static func == (l: NSString, r: NSString) -> Bool { l.value == r.value }
+    public func hash(into h: inout Hasher) { h.combine(value) }
+}
+
+/// Bounded cache with NSCache's surface (count limit only).
+public final class NSCache<Key: Hashable & AnyObject, Value: AnyObject>: @unchecked Sendable {
+    private var storage: [Key: Value] = [:]
+    private var order: [Key] = []
+    private let mutex = NSLock()
+    public var countLimit: Int = 0
+    public var totalCostLimit: Int = 0
+    public init() {}
+    public func object(forKey key: Key) -> Value? { mutex.withLock { storage[key] } }
+    public func setObject(_ value: Value, forKey key: Key) { setObject(value, forKey: key, cost: 0) }
+    public func setObject(_ value: Value, forKey key: Key, cost: Int) {
+        mutex.withLock {
+            if storage.updateValue(value, forKey: key) == nil { order.append(key) }
+            if countLimit > 0, order.count > countLimit {
+                let drop = order.removeFirst()
+                storage[drop] = nil
+            }
+        }
+    }
+    public func removeObject(forKey key: Key) {
+        mutex.withLock {
+            storage[key] = nil
+            order.removeAll { $0 == key }
+        }
+    }
+    public func removeAllObjects() { mutex.withLock { storage = [:]; order = [] } }
+}
