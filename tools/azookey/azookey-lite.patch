+public enum StringTransformLite: Sendable { case fullwidthToHalfwidth }
+public extension StringTransformLite {
+    static let toHalf: [Unicode.Scalar: String] = {
+        var m: [Unicode.Scalar: String] = [:]
+        for v in UInt32(0xFF01)...0xFF5E { m[Unicode.Scalar(v)!] = String(Unicode.Scalar(v - 0xFEE0)!) }
+        m["\u{3000}"] = " "
+        let pairs: [(String, String)] = [("￠", "¢"), ("￡", "£"), ("￢", "¬"), ("￣", "¯"), ("￤", "¦"), ("￥", "¥"), ("￦", "₩"),
+            ("。", "｡"), ("「", "｢"), ("」", "｣"), ("、", "､"), ("・", "･"), ("ー", "ｰ")]
+        for (f, h) in pairs { m[f.unicodeScalars.first!] = h }
+        let full = Array("ヲァィゥェォャュョッアイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワン".unicodeScalars)
+        let half = Array("ｦｧｨｩｪｫｬｭｮｯｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ".unicodeScalars)
+        for (f, h) in zip(full, half) { m[f] = String(h) }
+        let voiced = Array("ガギグゲゴザジズゼゾダヂヅデドバビブベボ".unicodeScalars), voicedBase = Array("ｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾊﾋﾌﾍﾎ".unicodeScalars)
+        for (f, h) in zip(voiced, voicedBase) { m[f] = String(h) + "ﾞ" }
+        let semi = Array("パピプペポ".unicodeScalars), semiBase = Array("ﾊﾋﾌﾍﾎ".unicodeScalars)
+        for (f, h) in zip(semi, semiBase) { m[f] = String(h) + "ﾟ" }
+        m["ヴ"] = "ｳﾞ"
+        return m
+    }()
+    static let toFull: [String: Unicode.Scalar] = {
+        var m: [String: Unicode.Scalar] = [:]
+        for (k, v) in toHalf where m[v] == nil || k.value >= 0xFF01 { m[v] = k }
+        return m
+    }()
+}
+
+public extension StringProtocol {
+    func applyingTransform(_ t: StringTransformLite, reverse: Bool) -> String? {
+        var out = ""
+        let scalars = Array(self.unicodeScalars)
+        var i = 0
+        while i < scalars.count {
+            if reverse {
+                if i + 1 < scalars.count, let f = StringTransformLite.toFull[String(scalars[i]) + String(scalars[i + 1])] {
+                    out.unicodeScalars.append(f); i += 2; continue
+                }
+                if let f = StringTransformLite.toFull[String(scalars[i])] { out.unicodeScalars.append(f) } else { out.unicodeScalars.append(scalars[i]) }
+            } else {
+                if let h = StringTransformLite.toHalf[scalars[i]] { out += h } else { out.unicodeScalars.append(scalars[i]) }
+            }
+            i += 1
+        }
+        return out
+    }
+}
+
+public struct CharacterSetLite: Sendable {
+    let test: @Sendable (Unicode.Scalar) -> Bool
+    public static let newlines = CharacterSetLite { [0x0A, 0x0B, 0x0C, 0x0D, 0x85, 0x2028, 0x2029].contains($0.value) }
+    public static let whitespaces = CharacterSetLite { $0.properties.isWhitespace && !newlines.test($0) }
+    public static let whitespacesAndNewlines = CharacterSetLite { $0.properties.isWhitespace }
+    public func contains(_ s: Unicode.Scalar) -> Bool { test(s) }
+}
+
+public extension StringProtocol {
+    func components(separatedBy set: CharacterSetLite) -> [String] {
+        var out: [String] = [], cur = ""
+        for s in self.unicodeScalars {
+            if set.contains(s) { out.append(cur); cur = "" } else { cur.unicodeScalars.append(s) }
+        }
+        out.append(cur)
+        return out
+    }
+    func trimmingCharacters(in set: CharacterSetLite) -> String {
+        let scalars = Array(self.unicodeScalars)
+        var lo = 0, hi = scalars.count
+        while lo < hi && set.contains(scalars[lo]) { lo += 1 }
+        while hi > lo && set.contains(scalars[hi - 1]) { hi -= 1 }
+        var out = ""
+        out.unicodeScalars.append(contentsOf: scalars[lo..<hi])
+        return out
+    }
+    func commonPrefix<T: StringProtocol>(with other: T, options: Int = 0) -> String {
+        var out = ""
+        for (a, b) in zip(self, other) { if a == b { out.append(a) } else { break } }
+        return out
+    }
+    func appending<T: StringProtocol>(_ other: T) -> String { String(self) + String(other) }
+}
+
+public extension String {
+    /// Only the integer conversions used here: %d, %02d, %04X.
+    init(format: String, _ args: CVarArg...) {
+        var out = "", argIndex = 0
+        var it = format.makeIterator()
+        while let c = it.next() {
+            guard c == "%" else { out.append(c); continue }
+            var spec = ""
+            while let n = it.next() {
+                spec.append(n)
+                if n.isLetter || n == "%" { break }
+            }
+            guard let conv = spec.last, conv != "%" else { out.append("%"); continue }
+            let flags = spec.dropLast()
+            let pad = flags.hasPrefix("0") ? "0" : " "
+            let width = Int(flags) ?? 0
+            let arg = argIndex < args.count ? args[argIndex] : 0
+            argIndex += 1
+            var body: String
+            let value: Int = (arg as? Int) ?? (arg as? Int32).map(Int.init) ?? (arg as? UInt32).map(Int.init) ?? (arg as? UInt16).map(Int.init) ?? (arg as? UInt8).map(Int.init) ?? 0
+            switch conv {
+            case "X": body = String(value, radix: 16, uppercase: true)
+            case "x": body = String(value, radix: 16)
+            case "@", "s": body = "\(arg)"
+            default: body = String(value)
+            }
+            if body.count < width { body = String(repeating: pad, count: width - body.count) + body }
+            out += body
+        }
+        self = out
+    }
+}
+
+public extension FileManager {
+    struct DirectoryEnumerationOptionsLite: OptionSet, Sendable {
+        public let rawValue: Int
+        public init(rawValue: Int) { self.rawValue = rawValue }
+        public static let skipsHiddenFiles = Self(rawValue: 1)
+    }
+    func contentsOfDirectory(at url: URL, includingPropertiesForKeys keys: [URLResourceKey]?, options: DirectoryEnumerationOptionsLite = []) throws -> [URL] {
+        try contentsOfDirectory(atPath: url.path).filter { !options.contains(.skipsHiddenFiles) || !$0.hasPrefix(".") }
+            .map { url.appendingPathComponent($0) }
+    }
+}
