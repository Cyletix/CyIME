<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
    <!-- 本应用组件统一使用全限定类名：applicationId（com.cyletix.cyime）与 namespace
         （com.kingzcheung.xime）不同，相对类名的解析结果取决于 AGP 版本，
         写全限定名可无歧义地指向实际类所在包。 -->
    <application
        android:name="com.kingzcheung.xime.XimeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/cyime_launcher_facet"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/cyime_launcher_facet"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xime"
        tools:targetApi="31">
        
        <receiver
            android:name="com.kingzcheung.xime.clipboard.VerificationCodeSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <activity android:name="com.kingzcheung.xime.clipboard.ImageAccessActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- 主Activity -->
        <activity
            android:name="com.kingzcheung.xime.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:theme="@style/Theme.Xime">

            <!-- 接收其他应用分享的 .yaml / .zip 文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconOriginal"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="true" android:exported="true"
            android:icon="@mipmap/cyime_launcher_facet" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconNeon"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_neon" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconGlass"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_glass" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconFacet"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_facet" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.kingzcheung.xime.launcher.IconFrost"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/cyime_launcher_frost" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconOriginalBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_facet" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconNeonBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_neon" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconGlassBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_glass" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconFacetBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_facet" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.kingzcheung.xime.launcher.IconFrostBare"
            android:targetActivity="com.kingzcheung.xime.MainActivity"
            android:enabled="false" android:exported="true"
            android:icon="@drawable/cyime_launcher_bare_frost" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name="com.kingzcheung.xime.CustomLayoutActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 输入法服务 -->
        <service
            android:name="com.kingzcheung.xime.service.XimeInputMethodService"
            android:exported="true"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        
        <!-- AI 模型推理服务（独立进程，crash 不影响 IME） -->
        <service
            android:name="com.kingzcheung.xime.service.InferenceService"
            android:exported="false"
            android:process=":inference" />
        
        <!-- 离线语音识别服务（独立进程，模型推理不占用输入法进程内存） -->
        <service
            android:name="com.kingzcheung.xime.service.AsrInferenceService"
            android:exported="false"
            android:process=":asr" />
        
    </application>

</manifest>
