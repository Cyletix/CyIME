+// Bounded, one-syllable lookahead for short incomplete readings. Does not scan
+// the dictionary or alter the mapping/commit length of the typed prefix.
+vector<TableAccessor> TableQuery::PredictNextSyllable(size_t limit) const {
+  vector<TableAccessor> result;
+  auto index = level_ == 1 ? lv2_index_ : level_ == 2 ? lv3_index_ : nullptr;
+  if (!index) return result;
+  for (auto node = index->begin(); node != index->end() && result.size() < limit; ++node) {
+    auto accessor = Access(node->key);
+    if (accessor.exhausted()) continue;
+    accessor.set_matching_code_size(level_);
+    result.push_back(accessor);
+  }
+  return result;
+}
