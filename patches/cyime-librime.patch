+void NearSearchCorrector::RefreshNeighbors() {
+  const auto geometry = engine_->context()->get_property("cyime_neighbors");
+  if (geometry == geometry_) return;
+  geometry_ = geometry;
+  neighbors_.clear();
+  std::istringstream entries(geometry);
+  string entry;
+  while (std::getline(entries, entry, ';')) {
+    if (entry.size() < 2 || entry[1] != ':' || entry[0] < 'a' || entry[0] > 'z') continue;
+    for (size_t i = 2; i < entry.size() && i < 8; ++i) {
+      if (entry[i] >= 'a' && entry[i] <= 'z' && entry[i] != entry[0])
+        neighbors_[entry[0]].insert(entry[i]);
+    }
+  }
+}
+
+bool NearSearchCorrector::IsExtraKeyPress(char typed, char before, char after) {
+  // Like neighbour correction, no measured layout (a hardware keyboard) means no correction.
+  if (!engine_) return false;
+  RefreshNeighbors();
+  if (neighbors_.empty()) return false;
+  if (typed == before || typed == after) return true;
+  auto it = neighbors_.find(typed);
+  return it != neighbors_.end() && (it->second.count(before) || it->second.count(after));
+}
