+bool ScriptTranslator::PreparePrefixGraphCache(const string& input) {
+  auto* inc = incremental_.get();
+  if (!inc || !inc->enabled || !IsT9NumericInput(input)) return false;
+  // Syllabification is a pure function of the numeric input and this immutable
+  // translator/prism configuration. System word graphs also depend on the
+  // blacklist. Editor/composition epochs are NOT system word
+  // graph dependencies: deleting a digit must be able to reuse its exact prefix.
+  const auto dict_checksum = dict_->prism()->dict_file_checksum();
+  const auto schema_checksum = dict_->prism()->schema_file_checksum();
+  if (inc->prefix_dict_checksum != dict_checksum ||
+      inc->prefix_schema_checksum != schema_checksum ||
+      inc->prefix_blacklist != blacklist()) {
+    inc->prefix_graphs.clear();
+    inc->prefix_graph_units = 0;
+    inc->prefix_dict_checksum = dict_checksum;
+    inc->prefix_schema_checksum = schema_checksum;
+    inc->prefix_blacklist = blacklist();
+  }
+  return true;
+}
+
+const WordGraph* ScriptTranslator::FindPrefixGraph(const string& input) {
+  if (!PreparePrefixGraphCache(input)) return nullptr;
+  for (const auto& prefix : incremental_->prefix_graphs)
+    if (prefix.input == input) return &prefix.graph;
+  return nullptr;
+}
+
+void ScriptTranslator::RememberPrefixGraph(const string& input,
+                                           const WordGraph& graph) {
+  if (!PreparePrefixGraphCache(input)) return;
+  auto* inc = incremental_.get();
+  for (const auto& prefix : inc->prefix_graphs)
+    if (prefix.input == input) return;
+  size_t units = graph.size();
+  for (const auto& start : graph)
+    for (const auto& end : start.second) units += 1 + end.second.size();
+  constexpr size_t kMaxUnits = 16384;
+  constexpr size_t kMaxPrefixes = 32;
+  if (units > kMaxUnits) return;
+  while (!inc->prefix_graphs.empty() &&
+         (inc->prefix_graphs.size() >= kMaxPrefixes ||
+          inc->prefix_graph_units + units > kMaxUnits)) {
+    inc->prefix_graph_units -= inc->prefix_graphs.front().units;
+    inc->prefix_graphs.pop_front();
+  }
+  inc->prefix_graphs.push_back({input, graph, units});
+  inc->prefix_graph_units += units;
+}
