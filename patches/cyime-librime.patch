+string ScriptSyllabifier::CorrectionMarks(const Phrase* phrase) {
+  struct Step { size_t from, to; SyllableId id; bool corrected; };
+  vector<Step> path;
+  const Code code = phrase->matching_code();
+  SyllabifyTask task{
+      code, syllable_graph_, phrase->end() - start_,
+      [&](SyllabifyTask* task, size_t depth, size_t current_pos, size_t next_pos) {
+        bool corrected = false;
+        auto from = syllable_graph_.edges.find(current_pos);
+        if (from != syllable_graph_.edges.end()) {
+          auto to = from->second.find(next_pos);
+          if (to != from->second.end()) {
+            auto spelling = to->second.find(task->code[depth]);
+            corrected = spelling != to->second.end() && spelling->second.is_correction;
+          }
+        }
+        path.push_back({current_pos, next_pos, task->code[depth], corrected});
+      },
+      [&](SyllabifyTask* task, size_t depth) { path.pop_back(); }};
+  if (!syllabify_dfs(&task, 0, phrase->start() - start_) ||
+      std::none_of(path.begin(), path.end(), [](const Step& s) { return s.corrected; }))
+    return string();
+  Dictionary* dict = translator_->dict();
+  string marks;
+  for (const auto& step : path) {
+    string typed = input_.substr(step.from, step.to - step.from);
+    while (!typed.empty() && translator_->delimiters().find(typed.back()) != string::npos)
+      typed.pop_back();
+    if (!marks.empty()) marks += ' ';
+    marks += typed;
+    if (!step.corrected || !dict) continue;
+    Code syllable;
+    syllable.push_back(step.id);
+    vector<string> correct;
+    if (dict->Decode(syllable, &correct) && !correct.empty())
+      marks += '=' + correct.front();
+  }
+  return marks;
+}
